{
  "name": "civiceye-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-map-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript openapi/openapi.json -o src/types/api.generated.ts",
    "api:sync": "node -e \"require('fs').copyFileSync('../civiceye_server_side/openapi/openapi.json','openapi/openapi.json')\" && npm run api:types"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.105.3",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "CivicEye frontend: Next.js App Router web application.",
  "engines": {
    "node": ">=24"
  }
}
