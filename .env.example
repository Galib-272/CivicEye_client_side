# CivicEye frontend environment (civiceye_client_side/.env.local)
# Copy to .env.local for local development. NEXT_PUBLIC_* values are embedded in the
# browser bundle at build time, so they must never contain secrets.

# Base URL of the CivicEye API (civiceye_server_side), without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Show the /system-status diagnostics page. It is always available in development and
# hidden in production builds unless this is set to true.
NEXT_PUBLIC_ENABLE_SYSTEM_STATUS=false
